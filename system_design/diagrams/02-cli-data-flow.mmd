graph LR
    subgraph RO["read-only, no gate"]
        EVAL["evaluate --json"] --> BS["BootState"]
        BS --> PLANCMD["plan target --json"]
        PLANCMD --> PT["PlannedTransition"]
        BS --> REPCMD["report"]
        REPCMD --> RPT["report.json + report.sha256"]
        BS --> VERCMD["verify --baseline"]
    end

    subgraph GATE["human-owner gate"]
        ONETR["environment == OneTrueRecovery?"] --> CONF["live typed owner confirmation"]
    end

    subgraph MUT["gated mutation, P3/P4 not implemented"]
        PT --> APPLY["apply"]
        BS --> REVERT["revert"]
        APPLY --> FRESH["fresh BootState re-measurement"]
        REVERT --> FRESH
        FRESH --> HONEST["honesty check: claim success only if proven"]
    end

    PT -. "must pass gate" .-> ONETR
    BS -. "must pass gate" .-> ONETR
    CONF --> APPLY
    CONF --> REVERT
    APPLY -. "today: prints not implemented, exit non-zero" .-> MUT
