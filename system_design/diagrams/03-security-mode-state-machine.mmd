graph TD
    FULL["Full security mode"]
    REDUCED["ReducedSecurity: third-party kexts"]
    PERMISSIVE["PermissiveSecurity: custom kernel, ssv_enabled=false"]

    FULL -- "apply reduced-kexts, requires 1TR + owner confirm" --> REDUCED
    REDUCED -- "revert, requires 1TR + owner confirm" --> FULL
    FULL -- "apply permissive-custom-kernel, requires 1TR + owner confirm" --> PERMISSIVE
    PERMISSIVE -- "revert, requires 1TR + owner confirm" --> FULL

    REDUCED -. "no direct edge modeled" .-> PERMISSIVE
    PERMISSIVE -. "no direct edge modeled" .-> REDUCED

    GATE{{"environment == OneTrueRecovery AND live typed owner confirmation"}}
    GATE -. "gates every edge above" .-> FULL
    GATE -. "gates every edge above" .-> REDUCED
    GATE -. "gates every edge above" .-> PERMISSIVE

    FAIL["invariant violation on fresh measurement = exit 13"]
    FAIL -. "halt, preserve evidence, route to disclosure - never retry" .-> GATE
